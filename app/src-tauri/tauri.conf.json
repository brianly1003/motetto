{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motetto",
  "version": "0.1.0",
  "identifier": "local.motetto.desktop",
  "build": {
    "frontendDist": "../../ui/out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Motetto",
        "url": "main/",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "assetProtocol": {"enable": true, "scope": []},
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src 'self' asset: http://asset.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": [
      "binaries/whisper-server",
      "binaries/whisper-cli",
      "binaries/whisper-vad-speech-segments",
      "binaries/llama-server"
    ],
    "resources": ["resources/speed-sample.wav", "resources/LICENSES.md"]
  }
}
