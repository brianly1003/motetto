# Copy to .env (next to where you run motetto) or ~/.config/motetto/.env.
# These replace variables already set in the shell; ./.env wins over ~/.config/motetto/.env.
WHISPER_MODEL=$HOME/.cache/whisper/ggml-large-v3-q5_0.bin
WHISPER_VAD_MODEL=$HOME/.cache/whisper/ggml-silero-v5.1.2.bin
OLLAMA_MODEL=qwen3:8b
# Optional: a local model that fixes misheard words before the summary, in any language.
# Small models (4-8B) rarely help; a chunk the model translates or rewrites is kept as transcribed.
# FIX_MODEL=gemma3:27b
# Optional: names and jargon whisper and the summary model may not know (new products, people,
# project codes), comma-separated. Both use these spellings. Add a common mishearing if needed.
# Read only from ~/.config/motetto/.env or the shell; ignored in a project's ./.env.
# TERMS=Pusher Beams, FCM, Firebase Cloud Messaging, IGB
# Optional: label each voice on the call side (Speaker 2, 3…) with sherpa-onnx, locally. Set both
# or neither, and put the sherpa-onnx tool's bin folder on PATH (docs/README.md, "Speakers").
# DIARIZE_SEGMENTATION_MODEL=$HOME/.cache/sherpa-onnx/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
# DIARIZE_EMBEDDING_MODEL=$HOME/.cache/sherpa-onnx/3dspeaker_speech_campplus_sv_zh_en_16k-common_advanced.onnx
# Optional: transcripts longer than this many characters are summarized in parts, then merged.
# SUMMARY_CHUNK_CHARS=24000
# Optional, global .env or shell only: Ollama's port on 127.0.0.1 (default 11434).
# OLLAMA_PORT=11434
# Only these keys are read from .env files; anything else (PATH, OLLAMA_HOST…) is ignored.

# Desktop companion only. Also permits capture by screen-sharing apps. Restart Motetto after changing.
# OS capture protection is best effort; some capture tools may ignore it.
ALLOW_SCREENSHOTS=false
